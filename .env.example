# Certificate Verification System Configuration

# Database Configuration
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=certificate_verification

# File Upload Settings
UPLOAD_DIR=./uploads
STATIC_DIR=./static
MAX_UPLOAD_SIZE=10485760

# OCR Configuration
TESSERACT_CMD=

# Model Settings
MODEL_DIR=./models

# Dataset Configuration
# SSL Certificate Dataset
SSL_DATASET_DIR=./SSL-certificate-dataset-main
SSL_DATASET_FILE=SSL_dataset.csv

# Certificate Detection Dataset
CERTIFICATE_DATASET_DIR=./dataset
CERTIFICATE_DATA_YAML=data.yaml

# Security Settings
SECRET_KEY=your-secret-key-here

# CORS Settings (comma-separated URLs)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# Blockchain Settings (Optional)
USE_BLOCKCHAIN=false
BLOCKCHAIN_PROVIDER=

# Tamper Detection Settings
TAMPER_DETECTION_THRESHOLD=0.85